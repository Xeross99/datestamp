---
// The cookie banner (src/lib/consent.ts). Rendered only where there are
// ads or statistics (or on the dev server, to see it): without them the
// site sets no cookies and has nothing to ask. Slides in from below;
// "Customize" unfolds one switch per purpose; "Cookie settings" in the
// footer brings the banner back.
import { href, pathOf, t, type Locale } from "../i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const s = t(locale).consent
const purposes = [
  { name: "necessary", ...s.necessary, locked: true },
  { name: "analytics", ...s.analytics, locked: false },
  { name: "ads", ...s.ads, locked: false },
]
const button = "h-11 cursor-pointer rounded-lg px-4 text-sm font-semibold"
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-4 px-4 pb-4 opacity-0 transition duration-300 ease-out data-open:translate-y-0 data-open:opacity-100 motion-reduce:transition-none sm:px-6 sm:pb-6"
  data-consent
  inert
>
  <section
    class="ml-auto max-h-[calc(100svh-2rem)] max-w-xl overflow-y-auto rounded-xl bg-surface p-5 shadow-lg outline-1 outline-line in-data-open:pointer-events-auto sm:p-6"
    role="dialog"
    aria-labelledby="consent-text"
  >
    <p id="consent-text" class="text-sm/6 text-ink">
      {s.text} <a class="font-semibold text-accent underline-offset-2 hover:underline" href={href(pathOf("privacy", locale))}>{s.policy}</a>.
    </p>

    <!-- One switch per purpose; unfolds like the progress panel (grid rows 0fr ↔ 1fr). -->
    <div
      id="consent-details"
      class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-out data-open:grid-rows-[1fr] data-open:opacity-100 motion-reduce:transition-none"
      data-consent-details
      inert
    >
      <div class="min-h-0 overflow-hidden">
        <ul class="mt-4 flex flex-col gap-4 border-t border-line pt-4">
          {
            purposes.map(({ name, title, body, locked }) => (
              <li>
                <label class="flex cursor-pointer items-start justify-between gap-6 has-disabled:cursor-default">
                  <span>
                    <span class="block text-sm font-semibold text-ink">{title}</span>
                    <span class="mt-0.5 block text-xs/5 text-muted">{body}</span>
                  </span>
                  <span class="group relative mt-0.5 inline-flex h-6 w-11 flex-none rounded-full bg-line p-0.5 transition-colors duration-200 has-checked:bg-accent has-disabled:opacity-60 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent">
                    <input
                      class="absolute inset-0 size-full cursor-pointer appearance-none rounded-full focus:outline-none disabled:cursor-default"
                      type="checkbox"
                      role="switch"
                      name={name}
                      checked={locked}
                      disabled={locked}
                    />
                    <span class="pointer-events-none size-5 rounded-full bg-white shadow-xs transition-transform duration-200 group-has-checked:translate-x-5" />
                  </span>
                </label>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Accept and reject are equally easy: same size, side by side. -->
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button type="button" class={`${button} bg-accent text-on-accent hover:brightness-105`} data-consent-accept>{s.accept}</button>
      <button type="button" class={`${button} border border-line text-ink hover:border-line-strong`} data-consent-reject>{s.reject}</button>
      <button
        type="button"
        class="h-11 cursor-pointer px-1 text-sm font-medium text-muted underline-offset-4 hover:text-ink hover:underline"
        aria-controls="consent-details"
        aria-expanded="false"
        data-consent-customize
      >
        {s.customize}
      </button>
      <button type="button" class={`${button} border border-accent text-ink hover:bg-accent-soft`} data-consent-save hidden>{s.save}</button>
    </div>
  </section>
</div>

<script>
  import { mountConsent } from "../lib/consent"

  document.querySelectorAll<HTMLElement>("[data-consent]").forEach(mountConsent)
</script>
