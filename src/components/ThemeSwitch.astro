---
// Light / dark / system. The choice is a per-visitor convenience in
// localStorage; src/lib/theme.ts applies it, and an inline script in
// Base.astro's <head> applies it before first paint (no flash of the
// wrong theme).
import { t, type Locale } from "../i18n"

interface Props {
  locale: Locale
}

const s = t(Astro.props.locale).theme
---

<!-- 34 px tall, like the language button next to it (h-8.5 in Base.astro). -->
<div class="relative flex rounded-full border border-line p-0.5" role="group" aria-label={s.label} data-theme-switch>
  <span class="theme-switch-indicator absolute top-0.5 left-0.5 size-7 rounded-full bg-accent-soft" aria-hidden="true"></span>
  <button type="button" class="relative flex size-7 cursor-pointer items-center justify-center rounded-full text-muted transition-colors duration-300 hover:text-ink aria-pressed:text-accent motion-reduce:transition-none" data-theme-choice="light" aria-label={s.light} title={s.light} aria-pressed="false">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </button>
  <button type="button" class="relative flex size-7 cursor-pointer items-center justify-center rounded-full text-muted transition-colors duration-300 hover:text-ink aria-pressed:text-accent motion-reduce:transition-none" data-theme-choice="dark" aria-label={s.dark} title={s.dark} aria-pressed="false">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
  </button>
  <button type="button" class="relative flex size-7 cursor-pointer items-center justify-center rounded-full text-muted transition-colors duration-300 hover:text-ink aria-pressed:text-accent motion-reduce:transition-none" data-theme-choice="system" aria-label={s.system} title={s.system} aria-pressed="true">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="4" width="20" height="13" rx="2" />
      <path d="M8 21h8M12 17v4" />
    </svg>
  </button>
</div>

<script>
  import { mountThemeSwitch } from "../lib/theme"

  document.querySelectorAll<HTMLElement>("[data-theme-switch]").forEach(mountThemeSwitch)
</script>
