---
import Base from "../layouts/Base.astro"
import Editor from "./Editor.astro"
import ExamplePhoto from "./ExamplePhoto.astro"
import InlineAd from "./InlineAd.astro"
import { guidePages, href, pathOf, t, type Locale } from "../i18n"
import { SAMPLES_AUTHOR, samples } from "../lib/samples"
import { formatDate } from "../lib/stamp"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const strings = t(locale)
const home = strings.home
const sample = new Date(2026, 6, 14, 18, 30)
const local = strings.dateFormats[0]
// The examples: white with the time, a label bottom left, retro.
const timeFormat = strings.dateFormats.find((format) => format.endsWith("-time")) ?? local
const examples = [
  { style: "classic", date: formatDate(sample, timeFormat), corner: "bottom-right" },
  { style: "label", date: formatDate(sample, "iso"), corner: "bottom-left" },
  { style: "retro", date: formatDate(new Date(1998, 6, 14), "retro"), corner: "bottom-right" },
] as const


const faqJsonLd = {
  "@type": "FAQPage",
  mainEntity: home.faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
}
---

<Base locale={locale} page="home" title={home.title} description={home.description} schema={[faqJsonLd]}>
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 pt-6 pb-5 sm:pt-8">
    <div class="min-w-0">
      <h1 class="mb-1.5 text-[28px] leading-tight font-semibold tracking-tight sm:text-4xl">{home.h1}</h1>
      <p class="max-w-140 text-[15px] text-muted sm:text-base">{home.subtitle}</p>
    </div>
    <p class="font-mono text-[13px] text-muted">{home.facts.join(" · ")}</p>
  </div>

  <Editor locale={locale} />

  <section aria-labelledby="steps" class="pt-8 sm:pt-14">
    <div class="rounded-2xl bg-subtle px-5 py-10 sm:p-16">
      <h2 id="steps" class="text-center text-xl font-bold tracking-tight sm:text-2xl">{home.steps.title}</h2>
      <p class="mx-auto mt-2.5 max-w-130 text-center text-[15px] text-muted sm:text-base">{home.steps.subtitle}</p>
      <div class="mt-8 grid gap-9 sm:mt-12 lg:grid-cols-3 lg:gap-8">
        {
          home.steps.items.map(({ title, body }, index) => (
            <div class="text-center sm:flex sm:gap-6 sm:text-left lg:block lg:text-center">
              <svg class="mx-auto size-16 flex-none" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                {index === 0 && (
                  <>
                    <rect x="14" y="10" width="34" height="28" rx="4" fill="var(--subtle)" stroke="var(--muted)" stroke-width="2" />
                    <rect x="8" y="18" width="38" height="32" rx="4" fill="var(--surface)" stroke="var(--text)" stroke-width="2" />
                    <circle cx="19" cy="29" r="3.5" fill="var(--text)" />
                    <path d="m9 44 10-9 9 8 6-5 11 9" stroke="var(--text)" stroke-width="2" stroke-linejoin="round" />
                    <circle cx="48" cy="46" r="10" fill="var(--accent)" />
                    <path d="M48 41v10M43 46h10" stroke="var(--on-accent)" stroke-width="2.5" stroke-linecap="round" />
                  </>
                )}
                {index === 1 && (
                  <>
                    <defs>
                      <clipPath id="step-photo">
                        <rect x="7" y="13" width="50" height="38" rx="4" />
                      </clipPath>
                    </defs>
                    <rect x="6" y="12" width="52" height="40" rx="5" fill="var(--photo)" />
                    <g clip-path="url(#step-photo)">
                      <circle cx="19" cy="24" r="4.5" fill="#5f646a" />
                      <path d="M7 45 21 32l9 7 10-10 17 14v10H7Z" fill="#3c4045" />
                    </g>
                    <rect x="6" y="12" width="52" height="40" rx="5" stroke="var(--text)" stroke-width="2" />
                    <rect x="32" y="39" width="20" height="8" rx="2.5" fill="var(--accent)" />
                  </>
                )}
                {index === 2 && (
                  <>
                    <path d="M6 18a4 4 0 0 1 4-4h14l5 6h25a4 4 0 0 1 4 4v24a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4V18Z" fill="var(--surface)" stroke="var(--text)" stroke-width="2" stroke-linejoin="round" />
                    <circle cx="32" cy="36" r="11" fill="var(--accent)" />
                    <path d="M32 30v11M27 36.5l5 5 5-5" stroke="var(--on-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  </>
                )}
              </svg>
              <div class="mt-4 sm:mt-0 lg:mt-6">
                <h3 class="text-[15px] font-semibold">{title}</h3>
                <p class="mx-auto mt-2 max-w-70 text-sm leading-relaxed text-muted sm:mx-0 lg:mx-auto">{body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="examples" class="pt-10 sm:pt-12">
    <h2 id="examples" class="mb-4 text-xl font-semibold tracking-tight sm:mb-5 sm:text-[22px]">{home.examples.title}</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        examples.map((example, index) => (
          <figure class="m-0">
            <ExamplePhoto sample={samples[index].key} alt={home.examples.alts[samples[index].key]} {...example} />
            <figcaption class="mt-2 text-sm text-muted">{home.examples.captions[index]}</figcaption>
          </figure>
        ))
      }
    </div>
    <p class="mt-3 text-xs text-muted">
      {home.examples.photoBy} <a class="underline hover:text-ink" href={SAMPLES_AUTHOR.url} rel="noopener">{SAMPLES_AUTHOR.name}</a> / <a class="underline hover:text-ink" href="https://unsplash.com" rel="noopener">Unsplash</a>
    </p>
  </section>

  <!-- Away from the editor: AdSense forbids ads right next to its buttons. -->
  <InlineAd locale={locale} />

  <section aria-labelledby="faq" class="pt-10 sm:pt-12">
    <h2 id="faq" class="mb-2 text-xl font-semibold tracking-tight sm:text-[22px]">{home.faqTitle}</h2>
    <dl class="grid gap-x-10 sm:grid-cols-2">
      {
        home.faq.map(({ q, a }) => (
          <div class="border-b border-line py-4">
            <dt class="mb-1 font-semibold">{q}</dt>
            <dd class="m-0 text-[15px] text-muted">{a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="guides" class="pt-10 pb-4 sm:pt-12">
    <h2 id="guides" class="mb-3 text-xl font-semibold tracking-tight sm:text-[22px]">{home.guidesTitle}</h2>
    <ul class="grid gap-2 sm:grid-cols-2">
      {
        guidePages.map((guide) => (
          <li>
            <a
              class="flex min-h-12 items-center justify-between gap-3 rounded-lg border border-line bg-surface px-3.5 py-2 text-[15px] no-underline hover:border-line-strong"
              href={href(pathOf(guide, locale))}
            >
              {strings.guides[guide].h1}
              <svg class="size-4 flex-none text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

