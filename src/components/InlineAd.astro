---
// A responsive ad unit inside the content, shown only below RAILS_MIN_WIDTH:
// phones and tablets see no side rails, and they bring most of the traffic.
// Placed between sections, never right next to the editor's buttons
// (AdSense forbids ads that can be mistaken for controls).
import { t, type Locale } from "../i18n"
import { adsense } from "../lib/ads"

interface Props {
  locale: Locale
}

const label = t(Astro.props.locale).ads.label
const slot = adsense.slots.inline
const live = Boolean(adsense.client && slot)
---

{
  (live || import.meta.env.DEV) && (
    <aside class="ad-inline mx-auto mt-6 w-full max-w-84" aria-label={label}>
      <p class="mb-1.5 text-center font-mono text-[11px] tracking-widest text-muted uppercase">{label}</p>
      {live ? (
        <ins
          class="adsbygoogle block min-h-62.5"
          data-ad-client={adsense.client}
          data-ad-slot={slot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      ) : (
        <div class="flex h-62.5 items-center justify-center rounded-md bg-subtle font-mono text-xs text-muted">300 × 250</div>
      )}
    </aside>
  )
}
