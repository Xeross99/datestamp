---
// The share picture (og:image) of each language, as a 1200×630 page that
// `npm run assets` screenshots into public/og/<locale>.png. It exists only
// on the dev server: a production build has no such pages.
import "../../styles/global.css"
import { locales, t, type Locale } from "../../i18n"

export function getStaticPaths() {
  return import.meta.env.DEV ? locales.map((locale) => ({ params: { locale } })) : []
}

const locale = Astro.params.locale as Locale
const s = t(locale)
const facts = s.home.facts
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og</title>
  </head>
  <body class="m-0 bg-[#1c1b1a]">
    <div class="relative flex h-[630px] w-[1200px] overflow-hidden bg-[#1c1b1a] font-sans text-[#f5f2ed]" data-og>
      <div class="flex w-[640px] flex-col justify-between py-16 pl-18">
        <div class="text-[34px] font-extrabold tracking-tight">Date<span class="text-[#ff7a1a]">Stamp</span></div>
        <div>
          <h1 class="m-0 text-[76px] leading-[1.02] font-extrabold tracking-tight text-balance">{s.home.h1}</h1>
          <p class="mt-7 text-[25px] text-balance text-[#bdb6ae]">{facts.join(" · ")}</p>
        </div>
        <div class="text-[22px] text-[#bdb6ae]">{s.editor.privacy}</div>
      </div>

      <!-- A print with the date in the corner, tilted like one on a table. -->
      <div class="absolute top-[86px] right-[70px] w-[440px] rotate-[4deg] rounded-[14px] bg-[#f5f2ed] p-4 pb-14 shadow-[0_30px_60px_rgba(0,0,0,0.45)]">
        <div class="relative h-[330px] overflow-hidden rounded-[6px] bg-[linear-gradient(180deg,#f2a65a_0%,#e9805a_38%,#7c4f6e_70%,#2f2b45_100%)]">
          <div class="absolute top-[70px] left-[150px] size-[120px] rounded-full bg-[#ffd9a0] opacity-90"></div>
          <svg class="absolute inset-x-0 bottom-0" viewBox="0 0 408 150" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 110 L70 60 L130 95 L210 30 L290 90 L350 55 L408 85 V150 H0Z" fill="#2a2440" />
            <path d="M0 130 L90 95 L170 125 L260 90 L340 120 L408 105 V150 H0Z" fill="#1b1830" />
          </svg>
          <span class="absolute right-5 bottom-4 font-mono text-[34px] font-semibold text-[#ff8a1f] [text-shadow:0_0_5px_rgba(255,90,0,0.5)]">'26 7 14</span>
        </div>
      </div>
    </div>
  </body>
</html>
