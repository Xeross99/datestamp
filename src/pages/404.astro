---
// The page GitHub Pages serves for any address it does not have. It is one
// file for every language, so it carries each language's copy and a small
// script shows the one the address asks for (/pl/… → Polish), else the
// browser's language, else English. Not indexed, no ads.
import Base from "../layouts/Base.astro"
import ExamplePhoto from "../components/ExamplePhoto.astro"
import { defaultLocale, guidePages, href, locales, pathOf, t } from "../i18n"

const strings = t(defaultLocale)
// What the script needs per language: the title and where "home" is.
const meta = Object.fromEntries(locales.map((locale) => [locale, { title: t(locale).notFound.title }]))
---

<Base locale={defaultLocale} page="home" title={strings.notFound.title} description={strings.home.description} notFound>
  {
    locales.map((locale) => {
      const s = t(locale)
      return (
        <section class="mx-auto flex max-w-140 flex-col items-center py-10 text-center sm:py-16" lang={locale} data-not-found={locale} hidden={locale !== defaultLocale}>
          <div class="w-56 sm:w-64">
            <ExamplePhoto sample="forest" alt="" style="retro" date="'404" corner="bottom-right" />
          </div>
          <h1 class="mt-8 text-3xl font-extrabold tracking-tight sm:text-4xl">{s.notFound.h1}</h1>
          <p class="mt-3 text-[15px] text-muted sm:text-base">{s.notFound.body}</p>
          <a
            class="mt-6 inline-flex h-12 items-center rounded-lg bg-accent px-6 font-semibold text-on-accent no-underline hover:brightness-105"
            href={href(pathOf("home", locale))}
          >
            {s.notFound.cta}
          </a>
          <p class="mt-10 text-sm text-muted">{s.notFound.guides}</p>
          <ul class="mt-3 grid w-full gap-2 text-left">
            {
              guidePages.map((guide) => (
                <li>
                  <a
                    class="flex min-h-12 items-center justify-between gap-3 rounded-lg border border-line bg-surface px-3.5 py-2 text-[15px] no-underline hover:border-line-strong"
                    href={href(pathOf(guide, locale))}
                  >
                    {s.guides[guide].h1}
                    <svg class="size-4 flex-none text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      )
    })
  }
  <script is:inline define:vars={{ meta, base: href("/") }}>
    const segment = location.pathname.slice(base.length).split("/")[0]
    const browser = (navigator.languages || [navigator.language]).map((tag) => tag.slice(0, 2).toLowerCase())
    const locale = [segment, ...browser].find((code) => code in meta)
    if (locale) {
      document.querySelectorAll("[data-not-found]").forEach((section) => (section.hidden = section.dataset.notFound !== locale))
      document.documentElement.lang = locale
      document.title = meta[locale].title
    }
  </script>
</Base>
